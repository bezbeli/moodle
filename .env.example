# Moodle Environment Configuration
# Copy this file to .env and update with your actual values

# Database Configuration (PostgreSQL 18)
DB_HOST=localhost
DB_DATABASE=your_database_name
DB_USERNAME=your_db_username
DB_PASSWORD=your_secure_password
DB_PORT=5432

# Site Configuration
WWWROOT=https://domain.tld
DATAROOT=/home/forge/domain.tld/storage/moodledata
ADMIN=admin

# Optional: Debug settings (set to 1 for development, 0 for production)
# DEBUG=0
# DEBUGDISPLAY=0
